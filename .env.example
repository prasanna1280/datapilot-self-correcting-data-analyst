# ---- LLM ---------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# ---- Agent safety limits -------------------------------------------------
MAX_MESSAGES=12            # stop the team after this many messages per question
CODE_TIMEOUT_SECONDS=60    # kill a script that runs longer than this
TEAM_MODE=selector         # selector (default, SelectorGroupChat) | roundrobin

# ---- Code execution ------------------------------------------------------
EXECUTOR_MODE=local        # local (dev) | sandbox (docker-compose sets this)
SANDBOX_URL=http://sandbox:8800
SANDBOX_TOKEN=change-me    # shared secret between app and sandbox containers

# ---- App ---------------------------------------------------------------
APP_PASSWORD=              # optional: require a password to use the portal
MAX_UPLOAD_MB=50

# ---- Deployment (docker-compose + Traefik) -------------------------------
DOMAIN=datapilot.example.com
