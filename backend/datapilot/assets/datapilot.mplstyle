# DataPilot chart style - copied into every session sandbox as datapilot.mplstyle.
# Analysis scripts call plt.style.use("datapilot.mplstyle") so every chart looks the same.
# Categorical colours: validated palette, fixed order (blue, orange, aqua, yellow, magenta, green, violet, red).

figure.figsize      : 10, 5.6
figure.dpi          : 110
figure.facecolor    : FCFCFB
savefig.dpi         : 150
savefig.bbox        : tight
savefig.facecolor   : FCFCFB

font.family         : DejaVu Sans
font.size           : 10
text.color          : 0B0B0B

axes.facecolor      : FCFCFB
axes.edgecolor      : C9CDD3
axes.linewidth      : 0.8
axes.titlesize      : 13
axes.titleweight    : bold
axes.titlelocation  : left
axes.titlepad       : 12
axes.labelsize      : 10
axes.labelcolor     : 52514E
axes.spines.top     : False
axes.spines.right   : False
axes.grid           : True
axes.grid.axis      : y
axes.axisbelow      : True
axes.prop_cycle     : cycler("color", ["2A78D6", "EB6834", "1BAF7A", "EDA100", "E87BA4", "008300", "6250D6", "E34948"])

grid.color          : E6E8EB
grid.linewidth      : 0.8

xtick.color         : 52514E
ytick.color         : 52514E
xtick.labelsize     : 9
ytick.labelsize     : 9

lines.linewidth     : 2
lines.markersize    : 6
patch.linewidth     : 0

legend.frameon      : False
legend.fontsize     : 9
